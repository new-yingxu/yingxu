  "components": {
    "schemas": {
      "ActionReceipt": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "declined",
              "expired"
            ],
            "title": "State"
          },
          "resultCode": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Resultcode"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state"
        ],
        "title": "ActionReceipt"
      },
      "AgentTurnRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Query"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query"
        ],
        "title": "AgentTurnRequest"
      },
      "DeviceRegistration": {
        "properties": {
          "displayName": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Displayname"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "displayName"
        ],
        "title": "DeviceRegistration"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProposalRequest": {
        "properties": {
          "actionId": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Actionid"
          },
          "tool": {
            "type": "string",
            "enum": [
              "search_media",
              "get_backup_job",
              "preview_rename",
              "rename_item",
              "preview_move",
              "move_item",
              "upload_baidu",
              "upload_quark"
            ],
            "title": "Tool"
          },
          "fileIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Fileids"
          },
          "destinationGrantId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Destinationgrantid"
          },
          "requestedName": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 180,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Requestedname"
          },
          "query": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Query"
          },
          "jobId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Jobid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "title": "Expiresat"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tool",
          "expiresAt"
        ],
        "title": "ProposalRequest"
      },
      "SyncBatch": {
        "properties": {
          "events": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Events"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "events"
        ],
        "title": "SyncBatch"
      },
      "SyncPreferencesUpdate": {
        "properties": {
          "syncRecords": {
            "type": "boolean",
            "title": "Syncrecords"
          },
          "syncAgentSessions": {
            "type": "boolean",
            "title": "Syncagentsessions"
          },
          "syncThumbnails": {
            "type": "boolean",
            "title": "Syncthumbnails"
          },
          "syncPaths": {
            "type": "boolean",
            "title": "Syncpaths"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "syncRecords",
          "syncAgentSessions",
          "syncThumbnails",
          "syncPaths"
        ],
        "title": "SyncPreferencesUpdate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
