{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yingxu:sync-event:v1",
  "title": "YINGXU job snapshot event v1 - interface baseline, transport not implemented",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "deviceId",
    "sequence",
    "eventType",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "eventType": {
      "const": "job.snapshot.v1"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "name",
        "state",
        "phase",
        "files",
        "bytes",
        "progress",
        "targets"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "paused",
            "success",
            "partial",
            "cancelled",
            "failed"
          ]
        },
        "phase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "targets": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "state",
              "copied",
              "skipped",
              "verified",
              "failed"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "state": {
                "type": "string",
                "enum": [
                  "queued",
                  "running",
                  "paused",
                  "success",
                  "partial",
                  "cancelled",
                  "failed"
                ]
              },
              "copied": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "skipped": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "verified": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "failed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "source": {
          "type": "string",
          "maxLength": 4096
        },
        "paths": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    }
  }
}
