# Public CloudBase Authentication v2 settings. These values are not secrets.
VITE_CLOUDBASE_ENV_ID=
VITE_CLOUDBASE_REGION=ap-shanghai
VITE_CLOUDBASE_CLIENT_ID=
# Comma-separated exact origins configured in the CloudBase Web security allowlist.
# Tauri origins differ by platform; add only the exact origins that were configured.
VITE_CLOUDBASE_ALLOWED_ORIGINS=
# Keep false until email login/mail sending and the CloudBase web origin are configured.
VITE_CLOUDBASE_AUTH_READY=false

# HTTPS identity API. Local HTTP is accepted only for localhost/127.0.0.1/::1 development.
VITE_IDENTITY_API_BASE_URL=
# Keep false until the HTTPS API and its CORS policy are ready for the desktop origin.
VITE_IDENTITY_API_READY=false
