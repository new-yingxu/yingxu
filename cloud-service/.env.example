APP_ENV=development
APP_VERSION=0.4.1-ollama-preview
DATABASE_URL=sqlite:///./data/yingxu-cloud.db
# CloudBase REST alternative: leave DATABASE_URL empty in the deployed service.
CLOUDBASE_ENV_ID=
# Server secret only; never put this value in client code or Git.
CLOUDBASE_APIKEY=
AUTH_MODE=disabled
# Development only: set AUTH_MODE=dev and replace with a random local-only value.
DEV_AUTH_TOKEN=
# Production JWT verification requires a confirmed identity provider and claims contract.
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=
CORS_ORIGINS=


# Optional, server Secret only: JSON mapping verified owner IDs to BYOK credentials.
# Leave empty until configured through an approved secret manager. Never log it.
# Calls also require explicit useModel=true and stable sessionId/turnId.
MODEL_OWNER_CREDENTIALS=

# Development-only local option: owner entry {"provider":"ollama","model":"qwen2.5:7b"}.
# Endpoint is fixed loopback; no API key required. Never a production fallback.

# Optional CloudBase user-token -> short device-session exchange (disabled by default).
# AUTH_MODE=cloudbase requires all four values plus JWT_ISSUER/JWT_AUDIENCE.
# Client IDs must come from confirmed provider registration, not request headers.
CLOUDBASE_CLIENT_ORIGINS=
SESSION_KEY_ID=
# PEM RSA >=2048 bits, supplied only by server Secrets; never save a real key here.
SESSION_PRIVATE_KEY=

# Optional JWKS with up to 3 previous PUBLIC signing keys for rollout overlap.
# Never put private JWK fields or URLs in this object; active kid must differ.
SESSION_VERIFICATION_JWKS=
